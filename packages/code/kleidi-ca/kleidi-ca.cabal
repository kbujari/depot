name:               kleidi-ca
version:            0.1.0.0
build-type:         Simple
cabal-version:      >= 1.10

executable hakyll
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:    base == 4.*
                  , filepath >= 1.5.4.0
                  , hakyll == 4.16.*
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
